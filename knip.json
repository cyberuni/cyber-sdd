{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [".research/**"],
	"ignoreDependencies": ["husky"],
	"workspaces": {
		"apps/web": {
			"entry": ["src/**/*.{astro,ts,mdx}"],
			"project": ["src/**/*.{astro,ts,mdx}"]
		},
		"packages/cyber-sdd": {
			"project": ["src/**/*.ts"]
		},
		"plugins/sdd": {
			"entry": ["src/**/*.mts"],
			"project": ["src/**/*.mts"]
		},
		"plugins/aced": {
			"entry": ["src/**/*.mts"],
			"project": ["src/**/*.mts"]
		},
		"plugins/quill": {
			"entry": [],
			"project": []
		}
	}
}
