{
	"name": "cyber-sdd",
	"version": "0.2.1",
	"description": "Spec-Driven Development. Scaffold, validate, and maintain behavioral specs (spec.md + .feature files) for software features.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberuni/cyber-sdd.git",
		"directory": "plugins/sdd"
	},
	"license": "MIT",
	"type": "module",
	"bin": {
		"sdd-check-specs": "./skills/check-project-specs/scripts/check-project-specs.mts"
	},
	"files": [
		"skills",
		"agents",
		".plugin",
		".codex-plugin",
		".claude-plugin",
		"!skills/**/*.test.mts"
	],
	"dependencies": {
		"gherkin-cli": "0.0.2"
	},
	"scripts": {
		"check:spec": "node ./skills/check-project-specs/scripts/check-project-specs.mts",
		"test": "node --test \"skills/*/scripts/*.test.mts\"",
		"typecheck": "tsc -p tsconfig.json"
	},
	"homepage": "https://github.com/cyberuni/cyber-sdd"
}
