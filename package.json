{
	"name": "cyber-sdd-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"check:skills": "node plugins/aced/skills/improve-skill/scripts/validate.mts --root .",
		"check:private-skills": "node plugins/aced/skills/repair-private-skills/scripts/repair-private-skills.mts --root . validate",
		"check:plugins": "node plugins/sdd/skills/check-plugin-manifests/scripts/check-plugin-manifests.mts --root .",
		"check:specs": "node plugins/sdd/skills/check-project-specs/scripts/check-project-specs.mts --corpus && node plugins/sdd/skills/resolve-governances/scripts/resolve-governances.mts --root . && node plugins/sdd/skills/resolve-tracking/scripts/resolve-tracking.mts --root . && node plugins/sdd/skills/check-plan-safety/scripts/check-plan-safety.mts --root . --check && node plugins/sdd/skills/check-retired-terms/scripts/check-retired-terms.mts --root .",
		"knip": "knip",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"repair:private-skills": "node plugins/aced/skills/repair-private-skills/scripts/repair-private-skills.mts --root . repair",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && turbo run build typecheck test && pnpm check:skills && pnpm check:private-skills && pnpm check:plugins && pnpm check:specs && pnpm knip",
		"version": "changeset version",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"@types/node": "^24.12.4",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"turbo": "^2.10.8",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=22.11"
	}
}
