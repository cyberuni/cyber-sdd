{
	"name": "cyber-aced",
	"version": "0.5.1",
	"description": "Agent Config Evaluation & Development. Spec, evaluate, and improve agent configurations: skills, AGENTS.md sections, subagent definitions, and commands.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberuni/cyber-sdd.git",
		"directory": "plugins/aced"
	},
	"homepage": "https://github.com/cyberuni/cyber-sdd",
	"license": "MIT",
	"type": "module",
	"bin": {
		"aced-bench": "./dist/aced-bench.js"
	},
	"files": [
		"dist",
		"skills",
		"agents",
		"references",
		"plugin.json",
		".codex-plugin",
		".claude-plugin",
		"com.github.copilot",
		"CHANGELOG.md"
	],
	"dependencies": {
		"cyber-agentkit": "1.2.0"
	},
	"scripts": {
		"build": "tsdown",
		"build:skills": "universal-plugin plugin build",
		"check:scripts": "universal-plugin plugin build --check",
		"check:spec": "node ../sdd/src/check-project-specs/check-project-specs.mts",
		"test": "node --test \"src/**/*.test.mts\"",
		"typecheck": "tsc -p tsconfig.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"tsdown": "^0.23.0",
		"universal-plugin": "^0.16.0"
	},
	"engines": {
		"node": ">=22.11"
	}
}
