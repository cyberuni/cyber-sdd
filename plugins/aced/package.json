{
	"name": "cyber-aced",
	"version": "0.2.0",
	"description": "Agent Config Evaluation & Development. Spec, evaluate, and improve agent configurations: skills, AGENTS.md sections, subagent definitions, and commands.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberuni/cyber-sdd.git",
		"directory": "plugins/aced"
	},
	"homepage": "https://github.com/cyberuni/cyber-sdd",
	"license": "MIT",
	"type": "module",
	"bin": {
		"aced-bench": "./dist/aced-bench.js"
	},
	"files": [
		"dist",
		"skills",
		"agents",
		"governances",
		".plugin",
		".codex-plugin",
		".claude-plugin",
		"!skills/**/*.test.mts"
	],
	"dependencies": {
		"@cyberuni/agent-harness": "0.5.0"
	},
	"scripts": {
		"build": "tsdown",
		"check:spec": "node ../sdd/skills/check-project-specs/scripts/check-project-specs.mts",
		"test": "node --test \"skills/*/scripts/*.test.mts\"",
		"typecheck": "tsc -p tsconfig.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"tsdown": "^0.23.0"
	},
	"engines": {
		"node": ">=22.11"
	}
}
