{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"files": {
		"includes": [
			"!**/dist",
			"!**/node_modules",
			"!**/.turbo",
			"!skills-lock.json",
			"!.agents",
			"!**/.astro",
			"!.cyberfleet",
			"!.research",
			"!.claude",
			"!.github/scripts/min-release-age.mjs",
			"!plugins/sdd/src/vendor/gherkin-cli.mjs",
			"!plugins/sdd/skills/*/scripts/*.mjs",
			"!plugins/aced/skills/*/scripts/*.mjs",
			"!plugins/aced/com.github.copilot"
		]
	},
	"overrides": [
		{
			"includes": ["packages/cyberlegion/src/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": {
							"level": "error",
							"options": {
								"allow": ["log", "info", "warn", "error"]
							}
						}
					}
				}
			}
		}
	]
}
