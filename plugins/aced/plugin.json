{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "aced",
	"version": "0.4.3",
	"description": "Agent Config Evaluation & Development. Spec, evaluate, and improve agent configurations: skills, AGENTS.md sections, subagent definitions, and commands.",
	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/cyberuni/cyber-sdd",
	"repository": "https://github.com/cyberuni/cyber-sdd",
	"skills": "./skills",
	"agents": [
		"./agents/aced-case-judge.md",
		"./agents/aced-impl-judge.md",
		"./agents/aced-scenario-writer.md",
		"./agents/aced-spec-validator.md"
	],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"vendors": ["claude-code", "codex", "copilot-cli"],
			"scripts": {
				"skills/bench/scripts/bench.mjs": "src/bench/bench.mts",
				"skills/check-freshness/scripts/check-freshness.mjs": "src/check-freshness/check-freshness.mts",
				"skills/extract-situation/scripts/extract-situation.mjs": "src/extract-situation/extract-situation.mts",
				"skills/improve-skill/scripts/validate.mjs": "src/improve-skill/validate.mts",
				"skills/init-aced/scripts/ensure-results-ignored.mjs": "src/init-aced/ensure-results-ignored.mts",
				"skills/list-skills/scripts/list-skills.mjs": "src/list-skills/list-skills.mts",
				"skills/manage-skill-dirs/scripts/manage-skill-dirs.mjs": "src/manage-skill-dirs/manage-skill-dirs.mts",
				"skills/repair-private-skills/scripts/repair-private-skills.mjs": "src/repair-private-skills/repair-private-skills.mts",
				"skills/contribute-skill/scripts/source.mjs": "src/contribute-skill/source.mts"
			}
		}
	}
}
