{
	"name": "cyber-sdd",
	"version": "0.7.0",
	"description": "Spec-Driven Development. Scaffold, validate, and maintain behavioral specs (spec.md + .feature files) for software features.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberuni/cyber-sdd.git",
		"directory": "plugins/sdd"
	},
	"license": "MIT",
	"type": "module",
	"bin": {
		"sdd-check-specs": "./skills/check-project-specs/scripts/check-project-specs.mjs"
	},
	"files": [
		"skills",
		"agents",
		"plugin.json",
		".codex-plugin",
		".claude-plugin"
	],
	"scripts": {
		"build:skills": "universal-plugin plugin build",
		"build:vendor": "tsdown -c tsdown.vendor.config.ts",
		"check:scripts": "universal-plugin plugin build --check",
		"check:spec": "node ./src/check-project-specs/check-project-specs.mts",
		"test": "node --test \"src/**/*.test.mts\"",
		"typecheck": "tsc -p tsconfig.json"
	},
	"homepage": "https://github.com/cyberuni/cyber-sdd",
	"devDependencies": {
		"gherkin-cli": "0.2.1",
		"tsdown": "^0.23.0",
		"universal-plugin": "^0.16.0"
	},
	"engines": {
		"node": ">=22.11"
	}
}
